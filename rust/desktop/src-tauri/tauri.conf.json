{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Control Station",
  "version": "0.4.0",
  "identifier": "rust-control-station",
  "build": { "frontendDist": "../ui/dist", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm --prefix ui run dev", "beforeBuildCommand": "npm --prefix ui run build" },
  "app": { "windows": [{ "title": "Rust Control Station", "width": 1440, "height": 900, "minWidth": 1080, "minHeight": 680 }] },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
